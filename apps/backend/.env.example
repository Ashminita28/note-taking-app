# Runtime environment (development | test | production)
NODE_ENV=development

# Server port
PORT=3000

# PostgreSQL connection string — matches docker-compose.yml service by default
DATABASE_URL=postgresql://notetaking:notetaking@localhost:5433/notetaking_dev

# JWT signing key — REQUIRED. Replace with a real 256+ bit secret before deploying.
JWT_SECRET=changeme-replace-with-a-real-256-bit-secret

# Access/refresh token lifetimes
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Allowed frontend origin — REQUIRED
CORS_ORIGIN=http://localhost:5173

# Public frontend base URL, used to build share links — REQUIRED
FRONTEND_URL=http://localhost:5173

# Bcrypt cost factor
BCRYPT_ROUNDS=12

# Password reset OTP validity (minutes)
OTP_EXPIRY_MINUTES=10

# Password reset token validity (minutes)
RESET_TOKEN_EXPIRY_MIN=15

# Default share link expiry (hours) — 168 = 7 days
SHARE_DEFAULT_EXPIRY_HRS=168

# Version snapshot purge threshold (days)
VERSION_PURGE_DAYS=90

# Minimum versions to retain per note
VERSION_MIN_RETAIN=10

# Logging level
LOG_LEVEL=info
