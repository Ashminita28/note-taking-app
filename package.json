{
  "name": "note-taking-app",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": "22.16.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "lint": "pnpm -r --if-present run lint",
    "test": "pnpm -r --if-present run test",
    "dev": "pnpm --parallel --filter @note-app/backend --filter @note-app/frontend run dev",
    "dev:backend": "pnpm --filter @note-app/backend run dev",
    "dev:frontend": "pnpm --filter @note-app/frontend run dev",
    "db:migrate": "pnpm --filter @note-app/backend exec prisma migrate dev",
    "db:generate": "pnpm --filter @note-app/backend exec prisma generate",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "19.8.0",
    "@commitlint/config-conventional": "19.8.0",
    "@typescript-eslint/eslint-plugin": "8.30.0",
    "@typescript-eslint/parser": "8.30.0",
    "cross-env": "7.0.3",
    "eslint": "9.25.0",
    "eslint-config-prettier": "10.1.2",
    "husky": "9.1.7",
    "prettier": "3.5.3",
    "typescript": "5.9.2"
  }
}
